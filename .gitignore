# WorkFlowOS Global Git Ignore

# IDE / Editor configuration
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# Frontend build & dependencies
frontend/node_modules/
frontend/dist/
