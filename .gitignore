# WorkFlowOS Global Git Ignore

# IDE / Editor configuration
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# Frontend build & dependencies
frontend/node_modules/
frontend/dist/
# Environment & secrets
.env
*.env
.env.*
!.env.example
frontend/.env.local
frontend/.env.*.local
*.log

# Backend build & dependencies
backend/target/
backend/*.class
backend/*.jar
backend/*.war
backend/.classpath
backend/.project
backend/.settings/

# OS/Temporary & Database
temp/
tmp/
*.mv.db
*.trace.db
